{
  "name": "vanwork-memory-core",
  "version": "0.8.1",
  "description": "Zero-dependency memory core for AI agents: pointer/core preloading, resident indexing with a hard budget, BM25/hybrid retrieval, daily-first writes, queue evidence thresholds, session-boundary extraction, superseding edits, auditable consolidation, and cloud-tier classification. Plain Markdown canon, fully rebuildable derived index.",
  "license": "MIT",
  "keywords": [
    "memory",
    "agent-memory",
    "ai-agent",
    "llm",
    "bm25",
    "retrieval",
    "rag",
    "rrf",
    "embeddings",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairunze3/deepseek-harness-memory-core.git"
  },
  "bugs": {
    "url": "https://github.com/cairunze3/deepseek-harness-memory-core/issues"
  },
  "homepage": "https://github.com/cairunze3/deepseek-harness-memory-core#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts",
    "tests"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:inproc": "node scripts/test-inproc.mjs",
    "smoke:client": "node scripts/client-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "eval": "node scripts/eval-memory.mjs",
    "repair:tags": "node scripts/repair-inline-tags.mjs",
    "calibrate": "node scripts/calibrate-search.mjs",
    "profile:config": "node scripts/apply-profile-config.mjs",
    "profile:config:apply": "node scripts/apply-profile-config.mjs --apply",
    "probe:mount": "node scripts/mount-probe.mjs",
    "probe:profile": "node scripts/profile-probe.mjs",
    "probe:switch": "node scripts/profile-switch-probe.mjs",
    "probe:archive": "node scripts/archive-contract.mjs",
    "probe": "node scripts/verify.mjs && node scripts/mount-probe.mjs && node scripts/profile-probe.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
