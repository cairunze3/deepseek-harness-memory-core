{
  "name": "vanwork-memory-core",
  "version": "0.4.1",
  "description": "VanWork 本地记忆核心层：索引常驻 + 硬预算 + BM25/混合检索 + 取代式修正 + 自动整合 + 云端分层策略，并把记忆的写入编排（锁/备份/原子写/取代留档）与常驻注入一并接管。与 dsh-memory-evolve 共用同一份 Markdown 正本、不抢占工具名、零平台包依赖。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts",
    "tests"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:inproc": "node scripts/test-inproc.mjs",
    "smoke:client": "node scripts/client-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "profile:config": "node scripts/apply-profile-config.mjs",
    "profile:config:apply": "node scripts/apply-profile-config.mjs --apply",
    "probe:mount": "node scripts/mount-probe.mjs",
    "probe:profile": "node scripts/profile-probe.mjs",
    "probe:switch": "node scripts/profile-switch-probe.mjs",
    "probe:archive": "node scripts/archive-contract.mjs",
    "probe": "node scripts/verify.mjs && node scripts/mount-probe.mjs && node scripts/profile-probe.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
